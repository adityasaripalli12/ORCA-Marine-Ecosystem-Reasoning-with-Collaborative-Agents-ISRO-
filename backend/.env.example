# Backend environment variables — copy to backend/.env for local dev.
# On Render, set these in the Environment Variables panel instead.
# NEVER commit this file with real values.

# Admin security passkey (for the PasskeyModal gate - default: orca@2026)
SECURITY_LOG_PASSKEY=$2b$12$YGnAJn.MnkY/hTgGg6mzNONfgcSPLUPMyBu3khgs8K9A6/jZi5On.
ORCA_SECURITY_KEY=$2b$12$YGnAJn.MnkY/hTgGg6mzNONfgcSPLUPMyBu3khgs8K9A6/jZi5On.

# Legacy support / Render
FLOWCHAT_SECURITY_KEY=$2b$12$YGnAJn.MnkY/hTgGg6mzNONfgcSPLUPMyBu3khgs8K9A6/jZi5On.

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_value

# Groq AI API key
GROQ_API_KEY=change_this_value

# Speech-to-Text (STT) Provider: groq_whisper (default) or mock
STT_PROVIDER=groq_whisper
GROQ_WHISPER_MODEL=whisper-large-v3

# CORS: comma-separated list of allowed origins
# Local dev: keep as-is. Production: set to your Netlify / Render URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database URL — leave blank to use SQLite (default for local dev)
# For production on Render, set to your PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
